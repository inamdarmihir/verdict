# Verdict environment template
# ----------------------------
# Copy to .env and fill in values you need. The offline demos
# (python -m verdict / examples/worked_example.py) need none of these.

# Optional: enable live model calls in examples/langgraph_supervisor.py
# Latest verified frontier model: gpt-5.6-sol (alias: gpt-5.6)
OPENAI_API_KEY=

# Optional: override model id (default: gpt-5.6-sol)
VERDICT_MODEL=gpt-5.6-sol

# Optional: Qdrant URL when using CalibrationStore against a real cluster
# (InMemoryCalibrationStore works with no server for local setup.)
QDRANT_URL=http://localhost:6333
